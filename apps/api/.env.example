DATABASE_URL=postgres://recovery:recovery@localhost:5432/recovery
GEMINI_API_KEY=
PORT=4000
API_BEARER_TOKEN=dev-local-token
LOG_LEVEL=info
DUE_ACTIONS_POLL_MS=60000
EXHAUSTION_SWEEP_MS=300000

# --- provider selection ---
# simulator (default, used by `pnpm test`) | razorpay (real Razorpay test mode)
PROVIDER=simulator

# --- Razorpay test mode (only needed when PROVIDER=razorpay) ---
# See docs/Razorpay_Test_Mode_Integration.md
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
PUBLIC_BASE_URL=http://localhost:4000
